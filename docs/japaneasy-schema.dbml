// ──────────────────────────────────────
// Enums
// ──────────────────────────────────────

Enum jlpt_level {
  N5
  N4
  N3
  N2
  N1
}

Enum unit_status {
  locked
  active
  completed
}

Enum card_status {
  new
  learning
  reviewing
  mastered
}

// ──────────────────────────────────────
// Better Auth tables
// ──────────────────────────────────────

Table user {
  id text [pk]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table session {
  id text [pk]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  ip_address text
  user_agent text
  user_id text [not null]

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

Table account {
  id text [pk]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: 'account_userId_idx']
  }
}

Table verification {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

// ──────────────────────────────────────
// Content tables (admin-managed)
// ──────────────────────────────────────

Table units {
  id uuid [pk, default: `gen_random_uuid()`]
  level jlpt_level [not null, unique]
  title varchar(100) [not null]
  description text
  display_order integer [not null]
  total_words integer [not null, default: 0]
  is_published boolean [not null, default: false]
  icon_url text
  color varchar(20)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    level [unique, name: 'idx_units_level']
    display_order [name: 'idx_units_display_order']
  }
}

Table words {
  id uuid [pk, default: `gen_random_uuid()`]
  unit_id uuid [not null]
  kanji varchar(100)
  kana varchar(100) [not null]
  romaji varchar(100)
  english text [not null]
  part_of_speech varchar(50)
  word_group integer [not null, note: 'Groups words into batches within a unit for gradual unlocking']
  display_order integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    unit_id [name: 'idx_words_unit']
    (unit_id, word_group) [name: 'idx_words_unit_group']
    (unit_id, display_order) [name: 'idx_words_unit_order']
  }
}

// ──────────────────────────────────────
// Courses (future — not in MVP)
//
Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  unit_id uuid [not null]
  title varchar(200) [not null]
  description text
  display_order integer [not null]
  is_published boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    unit_id [name: 'idx_courses_unit']
    (unit_id, display_order) [name: 'idx_courses_unit_order']
  }
}

Table lessons {
  id uuid [pk, default: `gen_random_uuid()`]
  course_id uuid [not null]
  title varchar(200) [not null]
  content text [not null]
  display_order integer [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    course_id [name: 'idx_lessons_course']
    (course_id, display_order) [name: 'idx_lessons_course_order']
  }
}

Ref: courses.unit_id > units.id [delete: cascade]
Ref: lessons.course_id > courses.id [delete: cascade]
// ──────────────────────────────────────

// ──────────────────────────────────────
// User progress tables
// ──────────────────────────────────────

Table user_progress {
  user_id text [pk]
  current_unit_id uuid [not null, note: 'The unit the user is currently working through']
  streak_count integer [not null, default: 0]
  last_review_date date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table user_unit_progress {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  unit_id uuid [not null]
  status unit_status [not null, default: 'locked']
  words_mastered_count integer [not null, default: 0]
  current_word_group integer [not null, default: 1, note: 'The highest word group unlocked so far']
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, unit_id) [unique, name: 'unique_user_unit']
    (user_id, status) [name: 'idx_userunits_user_status']
  }
}

Table user_words {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  word_id uuid [not null]
  status card_status [not null, default: 'new']
  ease_factor real [not null, default: 2.5]
  interval integer [not null, default: 0]
  repetitions integer [not null, default: 0]
  next_review_date timestamp [not null]
  times_correct integer [not null, default: 0]
  times_incorrect integer [not null, default: 0]
  last_reviewed_at timestamp
  added_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, word_id) [unique, name: 'unique_user_word']
    (user_id, next_review_date) [name: 'idx_userwords_user_nextreview']
    (user_id, status) [name: 'idx_userwords_user_status']
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  user_word_id uuid [not null]
  was_correct boolean [not null]
  previous_interval integer [not null]
  new_interval integer [not null]
  previous_status card_status [not null]
  new_status card_status [not null]
  time_spent integer
  reviewed_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, reviewed_at) [name: 'idx_reviews_user_reviewedat']
    (user_word_id, reviewed_at) [name: 'idx_reviews_userword_reviewedat']
  }
}

// ──────────────────────────────────────
// Future: User course progress

 Table user_course_progress {
   id uuid [pk, default: `gen_random_uuid()`]
   user_id text [not null]
   course_id uuid [not null]
   current_lesson_id uuid
   lessons_completed integer [not null, default: 0]
  started_at timestamp
   completed_at timestamp
   created_at timestamp [not null, default: `now()`]
   updated_at timestamp [not null, default: `now()`]

   indexes {
     (user_id, course_id) [unique, name: 'unique_user_course']
   }
 }

  Ref: user_course_progress.user_id > user.id [delete: cascade]
  Ref: user_course_progress.course_id > courses.id [delete: cascade]
 Ref: user_course_progress.current_lesson_id > lessons.id
// ──────────────────────────────────────

// ──────────────────────────────────────
// References (foreign keys)
// ──────────────────────────────────────

// Auth
Ref: session.user_id > user.id [delete: cascade]
Ref: account.user_id > user.id [delete: cascade]

// Content
Ref: words.unit_id > units.id [delete: cascade]

// User progress
Ref: user_progress.user_id > user.id [delete: cascade]
Ref: user_progress.current_unit_id > units.id
Ref: user_unit_progress.user_id > user.id [delete: cascade]
Ref: user_unit_progress.unit_id > units.id [delete: cascade]

// User words & reviews
Ref: user_words.user_id > user.id [delete: cascade]
Ref: user_words.word_id > words.id [delete: cascade]
Ref: reviews.user_id > user.id [delete: cascade]
Ref: reviews.user_word_id > user_words.id [delete: cascade]
